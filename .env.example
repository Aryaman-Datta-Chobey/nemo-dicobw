# Template for .env (copy to .env and fill in). This file is tracked; .env is not.
# Load into a shell with:  set -a; source ~/nemo-dicobw/.env; set +a

# Hugging Face (read for gated models; write only when publishing checkpoints).
# huggingface_hub and the `hf` CLI read HF_TOKEN automatically.
HF_TOKEN=

# Weights & Biases (leave empty and set WANDB_MODE=offline to disable syncing).
WANDB_API_KEY=
WANDB_MODE=offline
